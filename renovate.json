{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>SonarSource/renovate-config"
  ],
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "postUpgradeTasks": {
        "commands": ["npm ci --ignore-scripts", "npm run build"],
        "fileFilters": ["dist/**"],
        "executionMode": "branch"
      }
    }
  ]
}
